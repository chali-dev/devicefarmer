# The API's environment on the server: copy to <DEPLOY_DIR>/app.env (not committed; chmod 600).
# All variables: apps/api/src/config.ts. The containers use host networking, so 127.0.0.1 is the host.
# Set per colour by compose.app.yml, do NOT set here: NODE_ENV API_HOST API_PORT SCRCPY_RELAY_PORT BACKGROUND_WORK APP_VERSION DEPLOY_COLOR
TZ=UTC
DATABASE_URL=postgres://cloudphone:<POSTGRES_PASSWORD from deploy.env>@127.0.0.1:5432/cloudphone
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -hex 32. Also derives the key of stored secrets (S3, proxies, tokens): never rotate casually.
JWT_SECRET=<random>
ADMIN_USERNAME=admin
# Needed by the seed that deploy.sh runs (SEED_ON_DEPLOY=1); only used when the admin is first created.
ADMIN_PASSWORD=<initial admin password>

# Public URL (reverse proxy). OAuth redirect URIs: ${PUBLIC_BASE_URL}/api/platforms/<p>/callback
WEB_ORIGIN=https://cloud.example.com
PUBLIC_BASE_URL=https://cloud.example.com

# Local redroid devices (Linux host with binder_linux); data of each device under INSTANCE_DATA_ROOT on the host.
DOCKER_HOST=unix:///var/run/docker.sock
INSTANCE_DATA_ROOT=/srv/cloudphone/instances
# STF's adb server reaches device ports through this name (deploy/stf.override.yml maps it to the host).
ADB_DEVICE_HOST=host.docker.internal
# BitBrowser adb tunnels bind on docker0 so STF's adb container can reach them (docs/08 §5); never 0.0.0.0.
EXTERNAL_ADB_BIND=172.17.0.1

# STF (infra/stf + deploy/stf.override.yml, loopback only)
STF_URL=http://127.0.0.1:7100
STF_WS_URL=http://127.0.0.1:7110
STF_ADB_HOST=127.0.0.1
STF_ADB_PORT=5037
STF_SERVICE_EMAIL=svc-cloudphone@cloudphone.local
STF_SERVICE_NAME=cloudphone-svc

# Optional: scrcpy relay for external phones through the proxy's /scrcpy-relay route
#SCRCPY_RELAY_URL=wss://cloud.example.com/scrcpy-relay

# Login slider captcha (拼图验证) is on by default; `off` only behind another login guard (e.g. an SSO gateway).
#LOGIN_CAPTCHA=off
#LOGIN_CAPTCHA_RATE=60
