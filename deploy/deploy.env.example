# Deployment settings on the server: copy to <DEPLOY_DIR>/deploy.env (not committed; chmod 600).
# The API's own environment is <DEPLOY_DIR>/app.env (from .env.example, production values: see docs/10-deployment.md).

# Compose project prefix: shared stack "<PROJECT>", colours "<PROJECT>-blue" / "<PROJECT>-green".
PROJECT=cloudphone
# Images (GHCR); the tag is the version passed to deploy.sh.
API_IMAGE=ghcr.io/<owner>/<repo>-api
WEB_IMAGE=ghcr.io/<owner>/<repo>-web
# 1 = docker pull every deploy (needs `docker login ghcr.io` once); 0 = images must exist locally.
PULL=1

# Reverse proxy (Caddy). A domain = automatic HTTPS (ports 80/443 open); ":8080" = plain HTTP.
SITE_ADDRESS=cloud.example.com
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
CADDY_ADMIN=127.0.0.1:2019

# Postgres 17 / Redis (loopback only). app.env must use the same: DATABASE_URL=postgres://cloudphone:<pw>@127.0.0.1:5432/cloudphone
POSTGRES_PASSWORD=change-me
PG_PORT=5432
REDIS_PORT=6379

# Per-colour loopback ports (API, scrcpy relay listener, web).
BLUE_API_PORT=3101
GREEN_API_PORT=3102
BLUE_RELAY_PORT=3111
GREEN_RELAY_PORT=3112
BLUE_WEB_PORT=3201
GREEN_WEB_PORT=3202

# Readiness used for the switch: /api/ready = the API with Postgres+Redis (not STF/adb/Docker).
# /api/health also requires STF, adb and Docker: stricter, but a device-side outage then blocks deploys.
READY_PATH=/api/ready
READY_TIMEOUT=180
# Seconds between the switch and SIGTERM to the old colour; then up to STOP_GRACE for running tasks.
DRAIN_SECONDS=5
STOP_GRACE=120s
LEADER_TIMEOUT=60
# Run the idempotent seed after the migrations (built-in admin, needs ADMIN_PASSWORD in app.env; demo-user with
# DEMO_USER_PASSWORD; sample media + personas once).
SEED_ON_DEPLOY=1
# Remove local images of versions that are no longer rollback targets.
PRUNE_IMAGES=1
