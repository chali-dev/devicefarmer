# Local dev settings (not committed). Seeded admin credentials live here only.
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgres://cloudphone:cloudphone@127.0.0.1:5432/cloudphone
REDIS_URL=redis://127.0.0.1:6380
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: npm run db:seed also creates the normal user demo-user with this password (only on creation).
#DEMO_USER_PASSWORD=change-me

# Android host (Linux). Dev: Lima VM docker socket forwarded to the Mac.
DOCKER_HOST=unix://$HOME/.lima/redroid/sock/docker.sock
REDROID_IMAGE=redroid/redroid:12.0.0_64only-latest
INSTANCE_DATA_ROOT=/srv/cloudphone/instances
ADB_PORT_MIN=5555
ADB_PORT_MAX=5604
# Host name the STF adb server uses to reach published instance ports
ADB_DEVICE_HOST=host.docker.internal
# External phones (device sources such as BitBrowser are configured in the UI): local adb port range
#EXTERNAL_ADB_PORT_MIN=5700
#EXTERNAL_ADB_PORT_MAX=5799

# STF (infra/stf)
STF_URL=http://localhost:7100
STF_WS_URL=http://localhost:7110
STF_ADB_HOST=127.0.0.1
STF_ADB_PORT=5037
STF_SERVICE_EMAIL=svc-cloudphone@cloudphone.local
STF_SERVICE_NAME=cloudphone-svc

# Asset library (素材库). Local backend directory; the active backend (local / S3-compatible)
# is chosen by an admin in the UI (存储设置) and stored encrypted with a key derived from JWT_SECRET.
ASSET_DIR=var/assets
# Media library limits and tools (thumbnails: sharp; video cover/metadata: ffmpeg/ffprobe)
MEDIA_IMAGE_MAX_MB=20
MEDIA_VIDEO_MAX_MB=500
MEDIA_ALLOWED_TYPES=jpeg,png,webp,gif,mp4,mov,webm
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 操作日志保留天数（启动时及每 24 小时清理一次更早的记录）
AUDIT_RETENTION_DAYS=180
# 数据库备份 / 导入 (系统配置 → 数据). Dev: no pg_dump on the Mac, run the tools inside the Postgres container.
# PG_RESTORE_CMD unset = PG_DUMP_CMD with its trailing pg_dump replaced by pg_restore.
PG_DUMP_CMD=env -u DOCKER_HOST docker exec -i -e PGPASSWORD cloudphone-dev-postgres-1 pg_dump
# PG_RESTORE_CMD=env -u DOCKER_HOST docker exec -i -e PGPASSWORD cloudphone-dev-postgres-1 pg_restore
